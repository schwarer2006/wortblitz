rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Primitives ---
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidRoomCode(code) {
      return code is string && code.size() == 4 && code.matches('^[0-9]{4}$');
    }

    function isStringList(arr, maxLen, maxItemLen) {
      return arr is list && arr.size() <= maxLen && (arr.size() == 0 || (arr[0] is string && arr[0].size() <= maxItemLen));
    }

    // --- Validation Blueprints ---
    function isValidRoom(data, roomId) {
      return data.keys().hasAll([
          'code', 'hostUid', 'status', 'maxPlayers', 'turnMode', 'ruleVariant',
          'penaltyEnabled', 'roundDurationSec', 'targetScore', 'selectedCategory',
          'deckThemes', 'currentThemeIndex', 'currentTheme', 'roundNumber',
          'turnEndsAt', 'activeTurnUid', 'playerOrder', 'playersMeta',
          'usedWords', 'winnersOrder', 'lastActionNotice', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'code', 'hostUid', 'status', 'maxPlayers', 'turnMode', 'ruleVariant',
          'penaltyEnabled', 'roundDurationSec', 'targetScore', 'selectedCategory',
          'deckThemes', 'currentThemeIndex', 'currentTheme', 'roundNumber',
          'turnEndsAt', 'activeTurnUid', 'playerOrder', 'playersMeta',
          'usedWords', 'winnersOrder', 'lastActionNotice', 'createdAt', 'updatedAt'
        ])
        && data.code is string && data.code == roomId && isValidRoomCode(data.code)
        && isValidId(data.hostUid)
        && data.status in ['LOBBY', 'COUNTDOWN', 'PLAYING', 'ROUND_END', 'GAME_OVER']
        && data.maxPlayers is int && data.maxPlayers >= 2 && data.maxPlayers <= 8
        && data.turnMode in ['SIMULTANEOUS', 'TURN_BASED']
        && data.ruleVariant in ['CLASSIC', 'CHAOS']
        && data.penaltyEnabled is bool
        && data.roundDurationSec in [15, 20, 30]
        && data.targetScore is int && data.targetScore >= 5 && data.targetScore <= 30
        && data.selectedCategory is string && data.selectedCategory.size() >= 1 && data.selectedCategory.size() <= 80
        && isStringList(data.deckThemes, 80, 120)
        && data.currentThemeIndex is int && data.currentThemeIndex >= 0 && data.currentThemeIndex <= 80
        && data.currentTheme is string && data.currentTheme.size() <= 120
        && data.roundNumber is int && data.roundNumber >= 0 && data.roundNumber <= 100
        && data.turnEndsAt is number && data.turnEndsAt >= 0
        && data.activeTurnUid is string && data.activeTurnUid.size() <= 128
        && isStringList(data.playerOrder, 8, 128)
        && data.playersMeta is map && data.playersMeta.keys().size() <= 8
        && isStringList(data.usedWords, 100, 64)
        && isStringList(data.winnersOrder, 8, 128)
        && data.lastActionNotice is string && data.lastActionNotice.size() <= 160
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPlayer(data, playerId) {
      return data.keys().hasAll([
          'uid', 'name', 'avatar', 'isJunior', 'cards', 'cardCount',
          'actionCards', 'score', 'roundDealt', 'finishedRound',
          'lastScoredRound', 'secretThemeCount', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'name', 'avatar', 'isJunior', 'cards', 'cardCount',
          'actionCards', 'score', 'roundDealt', 'finishedRound',
          'lastScoredRound', 'secretThemeCount', 'createdAt', 'updatedAt'
        ])
        && data.uid is string && data.uid == playerId && isValidId(data.uid)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 24
        && data.avatar is string && data.avatar.size() >= 1 && data.avatar.size() <= 24
        && data.isJunior is bool
        && isStringList(data.cards, 25, 10)
        && data.cardCount is int && data.cardCount >= 0 && data.cardCount <= 25
        && isStringList(data.actionCards, 4, 24)
        && data.score is int && data.score >= 0 && data.score <= 200
        && data.roundDealt is int && data.roundDealt >= 0 && data.roundDealt <= 100
        && data.finishedRound is int && data.finishedRound >= 0 && data.finishedRound <= 100
        && data.lastScoredRound is int && data.lastScoredRound >= 0 && data.lastScoredRound <= 100
        && data.secretThemeCount is int && data.secretThemeCount >= 0 && data.secretThemeCount <= 2
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSecretTheme(data) {
      return data.keys().hasAll(['uid', 'hostUid', 'theme', 'createdAt'])
        && data.keys().hasOnly(['uid', 'hostUid', 'theme', 'createdAt'])
        && isValidId(data.uid) && data.uid == request.auth.uid
        && isValidId(data.hostUid)
        && data.theme is string && data.theme.size() >= 2 && data.theme.size() <= 80
        && data.createdAt is timestamp;
    }

    function isValidFeedEntry(data) {
      return data.keys().hasAll([
          'uid', 'playerName', 'avatar', 'word', 'letter', 'theme',
          'roundNumber', 'valid', 'reason', 'undone', 'visibleTo', 'createdAt'
        ])
        && data.keys().hasOnly([
          'uid', 'playerName', 'avatar', 'word', 'letter', 'theme',
          'roundNumber', 'valid', 'reason', 'undone', 'visibleTo', 'createdAt'
        ])
        && isValidId(data.uid) && data.uid == request.auth.uid
        && data.playerName is string && data.playerName.size() >= 1 && data.playerName.size() <= 24
        && data.avatar is string && data.avatar.size() >= 1 && data.avatar.size() <= 24
        && data.word is string && data.word.size() >= 1 && data.word.size() <= 64
        && data.letter is string && data.letter.size() >= 1 && data.letter.size() <= 10
        && data.theme is string && data.theme.size() >= 1 && data.theme.size() <= 120
        && data.roundNumber is int && data.roundNumber >= 1 && data.roundNumber <= 100
        && data.valid is bool
        && data.reason is string && data.reason.size() <= 200
        && data.undone is bool
        && isStringList(data.visibleTo, 8, 128)
        && data.createdAt is timestamp;
    }

    function isValidChaosEvent(data) {
      return data.keys().hasAll([
          'type', 'fromUid', 'fromName', 'toUid', 'letter', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'type', 'fromUid', 'fromName', 'toUid', 'letter', 'status', 'createdAt', 'updatedAt'
        ])
        && data.type == 'GIFT'
        && isValidId(data.fromUid)
        && data.fromName is string && data.fromName.size() >= 1 && data.fromName.size() <= 24
        && isValidId(data.toUid) && data.toUid != data.fromUid
        && data.letter is string && data.letter.size() >= 1 && data.letter.size() <= 10
        && data.status in ['PENDING', 'ACCEPTED', 'BLOCKED']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // --- Collection Rules ---
    match /rooms/{roomId} {
      allow get: if isSignedIn() && isValidRoomCode(roomId);
      allow list: if false;

      allow create: if isSignedIn()
        && isValidRoomCode(roomId)
        && isValidRoom(incoming(), roomId)
        && incoming().hostUid == request.auth.uid
        && incoming().status == 'LOBBY'
        && incoming().roundNumber == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidRoomCode(roomId)
        && isValidRoom(incoming(), roomId)
        && incoming().code == existing().code
        && incoming().hostUid == existing().hostUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Host manages room setup, start, round progression, rematch
          (existing().hostUid == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'maxPlayers', 'turnMode', 'ruleVariant', 'penaltyEnabled',
              'roundDurationSec', 'targetScore', 'selectedCategory', 'deckThemes',
              'currentThemeIndex', 'currentTheme', 'roundNumber', 'turnEndsAt',
              'activeTurnUid', 'playerOrder', 'playersMeta', 'usedWords',
              'winnersOrder', 'lastActionNotice', 'updatedAt'
            ])
          )
          ||
          // Action 2: Player joins lobby (before game starts)
          (existing().status == 'LOBBY'
            && !(request.auth.uid in existing().playerOrder)
            && existing().playerOrder.size() < existing().maxPlayers
            && request.auth.uid in incoming().playerOrder
            && incoming().playerOrder.size() == existing().playerOrder.size() + 1
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'playerOrder', 'playersMeta', 'lastActionNotice', 'updatedAt'
            ])
          )
          ||
          // Action 3: Joined player updates their own playersMeta (score, cardCount, secretThemeCount)
          (request.auth.uid in existing().playerOrder
            && existing().status != 'GAME_OVER'
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'playersMeta', 'updatedAt'
            ])
          )
          ||
          // Action 4: Joined player plays a valid word or undoes a word during active round
          (request.auth.uid in existing().playerOrder
            && existing().status in ['COUNTDOWN', 'PLAYING']
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'usedWords', 'winnersOrder', 'playersMeta', 'activeTurnUid',
              'turnEndsAt', 'lastActionNotice', 'status', 'updatedAt'
            ])
          )
          ||
          // Action 5: Joined player activates Chaos card (THEME_SWAP or TIME_TURBO)
          (request.auth.uid in existing().playerOrder
            && existing().status == 'PLAYING'
            && existing().ruleVariant == 'CHAOS'
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'currentThemeIndex', 'currentTheme', 'usedWords', 'turnEndsAt',
              'lastActionNotice', 'updatedAt'
            ])
          )
        );

      allow delete: if isSignedIn() && isValidRoomCode(roomId) && existing().hostUid == request.auth.uid;

      // Private player hands: strictly owner-only
      match /players/{playerId} {
        allow get: if isSignedIn() && isValidRoomCode(roomId) && isValidId(playerId) && playerId == request.auth.uid;
        allow list: if false;

        allow create: if isSignedIn()
          && isValidRoomCode(roomId)
          && isValidId(playerId)
          && playerId == request.auth.uid
          && isValidPlayer(incoming(), playerId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/rooms/$(roomId));

        allow update: if isSignedIn()
          && isValidRoomCode(roomId)
          && isValidId(playerId)
          && playerId == request.auth.uid
          && isValidPlayer(incoming(), playerId)
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'avatar', 'isJunior', 'cards', 'cardCount',
            'actionCards', 'score', 'roundDealt', 'finishedRound',
            'lastScoredRound', 'secretThemeCount', 'updatedAt'
          ]);

        allow delete: if isSignedIn() && isValidRoomCode(roomId) && isValidId(playerId) && playerId == request.auth.uid;
      }

      // Secret lobby themes: private to author + host
      match /secretThemes/{themeId} {
        allow get: if isSignedIn() && isValidRoomCode(roomId) && isValidId(themeId)
          && (existing().uid == request.auth.uid || existing().hostUid == request.auth.uid);
        allow list: if isSignedIn()
          && (resource.data.uid == request.auth.uid || resource.data.hostUid == request.auth.uid);

        allow create: if isSignedIn()
          && isValidRoomCode(roomId)
          && isValidId(themeId)
          && isValidSecretTheme(incoming())
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/rooms/$(roomId))
          && get(/databases/$(database)/documents/rooms/$(roomId)).data.status == 'LOBBY'
          && get(/databases/$(database)/documents/rooms/$(roomId)).data.hostUid == incoming().hostUid
          && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.playerOrder;

        allow update: if false;
        allow delete: if isSignedIn() && isValidRoomCode(roomId) && isValidId(themeId)
          && (existing().uid == request.auth.uid || existing().hostUid == request.auth.uid);
      }

      // Live word ticker feed
      match /feed/{entryId} {
        allow get: if isSignedIn() && isValidRoomCode(roomId) && isValidId(entryId)
          && request.auth.uid in existing().visibleTo;
        allow list: if isSignedIn() && request.auth.uid in resource.data.visibleTo;

        allow create: if isSignedIn()
          && isValidRoomCode(roomId)
          && isValidId(entryId)
          && isValidFeedEntry(incoming())
          && incoming().createdAt == request.time
          && incoming().undone == false
          && exists(/databases/$(database)/documents/rooms/$(roomId))
          && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.playerOrder;

        allow update: if isSignedIn()
          && isValidRoomCode(roomId)
          && isValidId(entryId)
          && isValidFeedEntry(incoming())
          && existing().uid == request.auth.uid
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['undone']);

        allow delete: if false;
      }

      // Chaos action events (Karten-Geschenk)
      match /events/{eventId} {
        allow get: if isSignedIn() && isValidRoomCode(roomId) && isValidId(eventId)
          && (existing().toUid == request.auth.uid || existing().fromUid == request.auth.uid);
        allow list: if isSignedIn()
          && (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid);

        allow create: if isSignedIn()
          && isValidRoomCode(roomId)
          && isValidId(eventId)
          && isValidChaosEvent(incoming())
          && incoming().fromUid == request.auth.uid
          && incoming().status == 'PENDING'
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/rooms/$(roomId))
          && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.playerOrder
          && incoming().toUid in get(/databases/$(database)/documents/rooms/$(roomId)).data.playerOrder;

        allow update: if isSignedIn()
          && isValidRoomCode(roomId)
          && isValidId(eventId)
          && isValidChaosEvent(incoming())
          && existing().toUid == request.auth.uid
          && existing().status == 'PENDING'
          && incoming().status in ['ACCEPTED', 'BLOCKED']
          && incoming().fromUid == existing().fromUid
          && incoming().toUid == existing().toUid
          && incoming().letter == existing().letter
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);

        allow delete: if false;
      }
    }
  }
}
